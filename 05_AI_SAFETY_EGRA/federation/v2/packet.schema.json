{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renova:fed21:packet:v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "schema_version",
    "created_at",
    "expires_at",
    "source_node",
    "target_node",
    "project_id",
    "data_classification",
    "mission",
    "requested_operation",
    "source_refs",
    "state",
    "provider_receipt_id",
    "readback_verified"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 12
    },
    "schema_version": {
      "const": "2.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_node": {
      "type": "string",
      "minLength": 2
    },
    "target_node": {
      "type": "string",
      "minLength": 2
    },
    "project_id": {
      "const": "RENOVA-AI-SAFETY-GOVERNANCE"
    },
    "data_classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL"
      ]
    },
    "mission": {
      "type": "string",
      "minLength": 10
    },
    "requested_operation": {
      "enum": [
        "READ",
        "ANALYZE",
        "REVIEW",
        "PROPOSE_PATCH"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "state": {
      "enum": [
        "PREPARED",
        "DISPATCHED",
        "ACKNOWLEDGED",
        "REJECTED",
        "EXPIRED"
      ]
    },
    "provider_receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "readback_verified": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "ACKNOWLEDGED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "provider_receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "readback_verified": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "PREPARED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "provider_receipt_id": {
            "type": "null"
          },
          "readback_verified": {
            "const": false
          }
        }
      }
    }
  ]
}
