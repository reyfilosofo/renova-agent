{
  "schema_version": "1.0",
  "required": [
    "packet_id",
    "schema_version",
    "created_at_utc",
    "source_node",
    "target_node",
    "project_id",
    "classification",
    "evidence",
    "action",
    "authorization",
    "state"
  ],
  "classification": [
    "P0_PUBLIC",
    "P1_INTERNAL",
    "P2_CONFIDENTIAL",
    "P3_SECRET"
  ],
  "state": [
    "DRAFT",
    "READY",
    "SENT",
    "ACKNOWLEDGED",
    "FAILED",
    "BLOCKED"
  ],
  "authorization": [
    "not_requested",
    "approved_for_preparation",
    "explicit_publish_authorization"
  ],
  "note": "SENT and ACKNOWLEDGED require external provider receipt; hash is integrity, not authenticated permission."
}
